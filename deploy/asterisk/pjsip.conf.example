; SIP accounts for the family's phones (any SIP app: Linphone, Zoiper, the phone's own SIP client).
; Copy to pjsip.conf and set real passwords; pjsip.conf stays out of git.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

; ---- extension 101: «мама»
[101]
type=endpoint
context=from-phones
disallow=all
allow=opus,ulaw,alaw
auth=101-auth
aors=101
direct_media=no

[101-auth]
type=auth
auth_type=userpass
username=101
password=CHANGE-ME-101

[101]
type=aor
max_contacts=2

; ---- extension 102: «папа» — copy the three sections above for each phone.

; ---- a SIP operator for real numbers: a registration and an endpoint of the operator's kind (their settings).
