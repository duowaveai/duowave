#!/bin/sh
# Before a push: nothing private leaves this computer — neither in the tree that goes, nor in the lines of any commit
# the remote does not have yet, which would stay in its history for good (scripts/release/check-private.mjs, with the
# household's .private-terms). On once per clone: `pnpm hooks` (git config core.hooksPath .githooks).
# Past it on purpose, and only knowing why: git push --no-verify.
set -eu
ROOT=$(git rev-parse --show-toplevel)
CHECK="$ROOT/scripts/release/check-private.mjs"
[ -f "$CHECK" ] || exit 0
ZERO=0000000000000000000000000000000000000000
failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue # a branch deleted: nothing goes
    echo "check-private: $local_ref -> $remote_ref"
    node "$CHECK" --commits "$local_sha" || failed=1
    tree=$(mktemp -d)
    git archive "$local_sha" | tar -x -C "$tree"
    node "$CHECK" --dir "$tree" || failed=1
    rm -rf "$tree"
done
if [ "$failed" -ne 0 ]; then
    echo "push stopped: something private, above. Take it out, or push with --no-verify knowing why." >&2
    exit 1
fi
