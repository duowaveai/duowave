# App configuration. Everything the gateway needs is here: run it with `duowave serve` (gateway/README.md), no
# variables on the command line (they would win over this file).
NODE_ENV=dev
# The station connects to ws://<host>:<PORT><UNIPROXY_PATH>; its uniProxyUrl must match (the panel's «Подключить»
# writes it). 7780 by default: an uncommon port, free on most machines; any free one works.
PORT=7780
# HTTPS for the call page from a phone: browsers give the microphone only to secure pages. A certificate for this
# Mac's address, e.g. `mkcert 192.0.2.10` (and mkcert's root CA installed on the phone). Empty: no HTTPS.
# HTTPS_PORT=8443
# TLS_CERT_FILE=certs/192.0.2.10.pem
# TLS_KEY_FILE=certs/192.0.2.10-key.pem

# Station voice connection
UNIPROXY_PATH=/uni.ws
# gateway: we answer the station (recognition, dialog, speech).
# relay: the station's session goes to Yandex unchanged and every frame both ways is journaled, with the audio
# of each stream as a file: to study the original Alice. The station then works as before the gateway.
# A new gateway starts in relay («Яндекс» in the panel): switch to gateway there, one capability at a time.
UNIPROXY_MODE=relay
# Yandex's uniproxy: our speech session in gateway mode, the station's whole session in relay mode.
YANDEX_UNIPROXY_URL=wss://uniproxy.alice.yandex.net/uni.ws
# Relay mode: ping Yandex this often and cut a connection that stays silent until the next ping, so the
# station reconnects (its own pings stop at the gateway and never reach Yandex). 0 turns it off.
RELAY_PING_MS=15000
# Our own session with Yandex (speech, pushes, the Yandex route): ping it this often and reopen it when it stays
# silent until the next ping. 0 turns it off.
YANDEX_PING_MS=15000
# The station's socket, in both modes: ping it this often and cut it once the station has sent nothing at all for
# three pings in a row (it pings us every 5 s itself). Without it a station that rebooted or lost the network stays
# «connected» until the gateway happens to write to it. 0 turns it off; at most 3600000 (an hour).
STATION_PING_MS=15000
# Yandex's pushes (reminders, incoming calls, notifications) arrive on our session: pass them to the station, or
# drop them (journal only). Without them Yandex's reminders and calls do not reach the station in gateway mode.
YANDEX_PUSHES=pass
# The Yandex route: wait this long for Yandex's response, then between the frames of its speech; after that the
# station hears "Яндекс не ответил."
YANDEX_TIMEOUT_MS=10000
# Safety net per voice request (wall clock); VAD normally ends a request within a few seconds.
VOICE_MAX_UTTERANCE_MS=20000
# A slow answer (a web search, an MCP tool, a slow voice) keeps the station waiting with silence on its stream: the
# station drops speech that has kept it 10 s without audio. At most this long from the answer's start; then the
# stream closes and the answer goes on in the background (deferred).
ANSWER_WAIT_MAX_MS=45000
# A deferred answer is said through our push (as a reminder is) once its text is complete and the station is free,
# if that is within this long from its start; later it is dropped. «Алиса, стоп» with nothing else to stop drops it
# too.
DEFERRED_MAX_MS=300000

# Session journal: data/sessions/<day>/<time>_<device>_<session>/events.jsonl and audio/*
RECORDER_ENABLED=true
RECORDER_DIR=data/sessions
# Station audio (*.in.ogg), the audio given to recognition (*.asr.wav), spotter logs (*_spotter_*.wav).
# Off by default: the voices of the household stay off the disk; turn it on while debugging.
RECORDER_AUDIO=false
# Replace device and account ids with short hashes in the journal and the debug API (tokens and cookies always are).
RECORDER_REDACT=true

# GET /debug/sessions, GET /debug/sessions/:id/events — off by default; never on where others reach the port.
DEBUG_API_ENABLED=false
# Who may use it: CIDR networks, comma-separated; "private" = home networks and localhost.
DEBUG_API_ALLOW=private
# The panel (/panel) signs in and its API (/api/v1) answers from outside the home too — through a Cloudflare
# tunnel or an open port. Off: everything that needs a sign-in answers at home only.
PANEL_REMOTE=false
# Who may connect as a station. tofu: the first station to connect is trusted, every later one waits for the
# admin's approval in the panel (and the owner is told); closed: approved stations only; open: any (a lab).
STATION_PAIRING=tofu
# Host names this gateway answers besides IP addresses and local names (*.local, *.lan, *.home, localhost):
# comma-separated. Anything else gets 421 — a web page cannot reach the gateway through a DNS name of its own.
ALLOWED_HOSTS=
SESSION_EVENTS_LIMIT=500
# Days of journals and audio kept (data/sessions/<day>, ~20 MB a day); 0 keeps everything. The station build: 2.
RECORDER_RETENTION_DAYS=7
# The whole journal at most this many MB: oldest days, then oldest sessions go; 0 is no cap. The station build: 10.
RECORDER_MAX_MB=0
# Tell when no station has been connected this many minutes: the log, a macOS notification, a webhook, Telegram.
STATION_OFFLINE_ALERT_MIN=5
# A macOS notification: on a Mac by default, off elsewhere.
# ALERT_MACOS_NOTIFY=true
# ALERT_WEBHOOK_URL=
# The owner's Telegram chat for alerts (through the calls' bot). FIRST START ONLY, like the connectors below: the
# panel sets it up («Дом» → «Коннекторы» → Telegram → «Оповещения»).
# ALERT_TELEGRAM_CHAT=

# VAD and the end of the command. Decisions use audio time, so a recorded request gives the same ones again.
# silero (assets/silero_vad.onnx) | energy (level-based fallback)
VAD_ENGINE=silero
VAD_MODEL_PATH=assets/silero_vad.onnx
# Speech probability threshold; "silence" is below threshold − 0.15.
VAD_THRESHOLD=0.5
# The wake word still sounds ~300 ms after SpotterEnd: no decisions during this guard.
VAD_GUARD_MS=320
VAD_SPEECH_START_MS=96
# Silence that ends the command. Shorter is snappier but cuts phrases with pauses.
VAD_END_SILENCE_MS=700
# No command this long after SpotterEnd: empty result, the station goes idle.
VAD_NO_SPEECH_MS=5000
VAD_MAX_SPEECH_MS=15000
# Energy engine only: level after gain that counts as speech.
VAD_ENERGY_THRESHOLD_DBFS=-40

# Gain before VAD and recognition: after the station's VQE speech peaks around -40 dBFS.
# auto: picked per request from the wake word (its loudest 32 ms window → AUDIO_GAIN_TARGET_DBFS); or a fixed dB value.
AUDIO_GAIN=auto
AUDIO_GAIN_MAX_DB=40
AUDIO_GAIN_TARGET_DBFS=-20
# auto, a request without the wake word (listening on after a question, a button, a wake word of our own): the gain
# its session's last wake word got, else the median of the station's last five (kept in the database); before the
# station's first, this. The maximum makes room noise speech for VAD.
AUDIO_GAIN_NO_WAKE_WORD_DB=30

# Speech recognition: any OpenAI-compatible POST /audio/transcriptions (openai), or this computer itself (local).
# local: GigaAM, Parakeet or Whisper as GGUF through transcribe.cpp in a worker of this program — no Python, no
# server; the model chosen in the panel is fetched once (GigaAM v3 — 274 MB). A build with the feature local-asr only
# (the desktop app, where it is the default unless ASR_BASE_URL is set). The models go to ASR_LOCAL_DIR, else
# DATA_DIR/speech; ASR_MODELS_MIRROR — a folder of the same files, asked before Hugging Face; ASR_LOCAL_GPU=0 — the
# processor only (Metal on a Mac with Apple Silicon otherwise).
# Local GigaAM as a server: run asr-server/server.py (default http://127.0.0.1:8090/v1).
# OpenAI: ASR_BASE_URL=https://api.openai.com/v1, ASR_MODEL=gpt-4o-mini-transcribe, ASR_API_KEY=sk-...
ASR_PROVIDER=openai
ASR_BASE_URL=http://127.0.0.1:8090/v1
ASR_API_KEY=
# Our server (asr-server/) serves the model it loaded, chosen in the panel, whatever this says: health and the
# journal name the one it lists on GET /models. A cloud serves the model named here.
ASR_MODEL=gigaam-v3
ASR_LANGUAGE=ru
# ASR_PROMPT=
ASR_TIMEOUT_MS=8000
# Interim AsrResult every N ms while the station records. Without text in them the station closes
# its stream with NO_SPEECH ~5 s after VoiceInput, even mid-sentence: the text comes from the next setting.
ASR_PARTIAL_INTERVAL_MS=300
# While the command is spoken, recognise it so far at most once per this much new audio (checked with
# each interim result). One request at a time; 0 turns it off. With a paid cloud ASR consider 1000+.
ASR_INTERIM_INTERVAL_MS=500
# Speech VAD does not hear (whispers, across the room): while VAD hears nothing after the wake word, all
# audio after it is recognised on the fly; words found keep the station listening and the command ends
# when they stop changing for ASR_QUIET_END_MS. Also one look at all audio when the final text is empty.
ASR_QUIET_SPEECH=true
# Whispers pause and recognition lags behind them: longer than VAD_END_SILENCE_MS.
ASR_QUIET_END_MS=2000
# Speech VAD hears ends too when its words stop changing for this long: with the gain high, room noise passes
# VAD_ENERGY_THRESHOLD_DBFS, VAD's end silence never comes and the command would run to VAD_MAX_SPEECH_MS.
# 0 leaves the end to VAD.
ASR_UNCHANGED_END_MS=2000
# A stop and nothing else («стоп», «хватит», «Алиса, стоп») ends the command as soon as the next interim result
# says it again, at least this much audio later; one result alone could go on («стоп, а какая погода?»).
# 0 waits for the end of speech.
ASR_STOP_END_MS=400
# Removed from the start of the recognised text (plus the spotter phrase the station reports).
WAKE_WORDS=алиса,яндекс

# Dialog: who answers the recognised question.
# The panel's «Модели → Мозг» adds providers with their own keys and picks the models; its choice wins over
# the lines below, which answer while the panel has chosen nothing.
# anthropic (Claude) | openai (any OpenAI-compatible /chat/completions) | echo (repeats the question, no LLM) | none
# none by default: until a model is chosen, what we cannot answer goes to Yandex.
DIALOG_PROVIDER=none
# anthropic: claude-haiku-5-5 by default (quick, for tests; claude-opus-5-5 is the strong one).
# openai: required, e.g. a Groq or Ollama model name.
# LLM_MODEL=
# Model profiles the router picks per request: fast — short replies, smart — hard questions and the choice of a
# tool. Each defaults to LLM_MODEL; switching a model is one line here.
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-haiku-5-5
# openai: https://api.groq.com/openai/v1, http://127.0.0.1:11434/v1 (Ollama), ...
# LLM_BASE_URL=
# anthropic: or ANTHROPIC_API_KEY in the environment, or an `ant auth login` profile.
LLM_API_KEY=
LLM_MAX_TOKENS=4096
# The workshop agent's turns write whole files (an app's window, its code): their own, longer limit. A model that
# refuses it as too long answers with LLM_MAX_TOKENS; a file cut off by it is written again in parts.
WORKSHOP_MAX_TOKENS=16000
# Claude's thinking depth (Opus 5.5 always thinks): low keeps spoken answers quick.
LLM_EFFORT=low
# Until the first phrase of the answer; the station gives up on a response after ~15 s.
LLM_TIMEOUT_MS=10000
# Read on every question: edit it and ask again. Empty: the built-in prompt (short spoken answers in Russian).
# DIALOG_SYSTEM_PROMPT_FILE=system-prompt.txt
# Question and answer pairs kept per device; a pause longer than the TTL starts the dialog over.
DIALOG_HISTORY_TURNS=8
DIALOG_HISTORY_TTL_S=300
# When the station keeps listening without the wake word after an answer:
# question — after an answer that ends with a question; always — after every answer in a conversation, as the
# generative Alice (silence ends it); never. (Replaces DIALOG_LISTEN_AFTER_QUESTION.)
DIALOG_LISTEN=question
# A conversational answer starts with AliceResponse and the jingle right after the end of speech, the speech
# follows, as with the generative Alice. should_listen then goes out before the text is known: in question mode
# the station's listening after an answer that asked nothing is closed at once.
DIALOG_EARLY_RESPONSE=true
# tts_play_placeholder in responses, as Yandex sends it: the station's jingle before the speech.
DIALOG_JINGLE=true
# Without the early response: when the first phrase can be heard, wait this long for the rest of the text.
DIALOG_HOLD_RESPONSE_MS=400

# Who serves each of Alice's capabilities in gateway mode (names: gateway/src/skills/capabilities.rs,
# docs/plans/capabilities.md).
# own — our implementation; yandex — the request goes to Yandex through our session; off — "not yet" and a
# journal entry; a list — in order: own,yandex is ours, and Yandex where we have nothing (or only a command
# known from the wiki and not yet checked on our station).
ROUTE_DEFAULT=own,yandex
# Exceptions per capability: radio=yandex;timers=own
ROUTES=
# Said when nobody can serve a request (GET /debug/unsupported lists them, /health counts them).
UNSUPPORTED_PHRASE=Этого я пока не умею.
# A Yandex dialog (a skill, a clarifying question) or our game takes follow-ups for this long.
DIALOG_CONTINUATION_S=120
# Capabilities whose requests go to Yandex as the station's voice instead of our recognised text: Yandex hears
# names (artists, stations) better, but then it gets the voice. Empty: only text goes to Yandex.
# YANDEX_VOICE=music
YANDEX_VOICE=
# Our timers, alarms and reminders per device and the player's last state, kept across restarts (the station keeps
# and rings them itself; this is our copy for "how much is left", cancel and stop): in the gateway's database,
# STATE_DIR/duowave.sqlite (gateway/src/storage). Empty: memory only.
STATE_DIR=data/state
# Our content for the station's player, served at /media with Range (content/README.md): radio.json, music/,
# tales/. Our links are not yet checked on the station (experiment 1): until then radio and music go to Yandex
# while it is on the route; ROUTES=radio=own;music=own makes them ours.
CONTENT_DIR=content
# How the station reaches /media; empty: the host it connects to for /uni.ws (http://<that host>/media).
# MEDIA_BASE_URL=http://192.0.2.10
# The gateway on the station turning an AAC stream into MP3 itself (the gateway's fallback, docs/plans/plugins.md,
# decision 9). Off by default: the load on the station's processor is not measured yet, and it may compete with
# Alice's own voice processing. Off, the computer (home server) transcodes, or the AAC station is skipped; 1 lets the
# station's gateway do it — after a measurement. On a computer it means nothing.
# MEDIA_TRANSCODE_ON_STATION=
# Where ffmpeg is for that transcoding; empty: the PATH, then /opt/homebrew/bin, /usr/local/bin, /usr/bin.
# FFMPEG=

# Packages (gateway/src/plugins, docs/plugins/AUTHORING.md): plugins, apps, characters and themes in PACKAGES_DIR as
# <id>/<version>/, switched on by the admin. Default: $DATA_DIR/packages, or data/packages beside the working copy.
# PACKAGES_DIR=data/packages
# The safe mode: 1 runs the gateway without any plugin, whatever is switched on.
# PLUGINS_DISABLED=
# A plugin's code leaves memory after this many seconds without a call (the next call loads it again). Default 600,
# on the station 120.
# PLUGINS_IDLE_UNLOAD_S=600
# The packages' catalog (catalog.json, docs/plans/characters.md): a release has ours built in; another one here (HTTPS,
# HTTP only from localhost), or off — the gateway never asks the network for it. Its copy: $DATA_DIR/packages-catalog.
# PACKAGES_FEED_URL=off
# The catalog's signing keys (minisign public keys, one per line: the line after the comment of `minisign -G`, or the
# .pub file whole); a release has ours built in (gateway/packages.pub: the release key and the reserve,
# docs/plans/key-rotation.md). With them and a catalog.json.minisig beside the feed that any of them signed, plugins
# and apps install from the catalog; without, only characters and themes do. Signing: scripts/sign-catalog.sh.
# PACKAGES_PUBKEY=
# The packages built into the gateway (packages/bundled.json: the radio, the weather, the news, one's own music, the
# tales, the games, the morning show, the smart home) are laid out into PACKAGES_DIR at every start and switched on
# the first time; 0 leaves them out, and the built-in skills answer alone.
# PLUGINS_BUNDLED=1
# Plugins act by themselves in time (docs/plans/plugin-schedules.md): the rhythms of their manifests and the tasks
# their code sets. 0 stops them all, the jobs kept; the panel's switch «Расписания плагинов» does the same.
# PLUGINS_SCHEDULES=1
# The home folder of DuoWave (docs/plans/shared-folders.md): one ordinary folder of this computer the voice, the agent
# and the apps work in — Фото, Документы, Видео, Загрузки, Картинки, Проекты, Подключено. The desktop app sets
# ~/DuoWave; without it, DATA_DIR/files/home (the station always keeps it in its data).
# HOME_FILES=
# Drives plugged in are offered for «Подключено» and a folder of the disk may be attached; 0 — neither, the home
# folder itself stays.
# FOLDERS=1
# The gateway on the station (docs/plans/plugins.md, «Память и место на колонке»): the memory kept for the system and
# Alice out of the plugins' budget, in MB (40 until it is measured under load), and the room on /data kept for the
# gateway's own update.
# PLUGINS_RESERVE_MB=40
# PLUGINS_STORAGE_RESERVE_MB=15
# At «critical» memory pressure on the station: disable — the app, else the plugin, switched on last goes off (said in
# the log and the panel); warn — only said.
# PLUGINS_PRESSURE_ACTION=disable

# ── Connectors: FIRST START ONLY. ──
# Home Assistant, Telegram, LiveKit, SIP, the weather's place and the news feeds are set up in the panel
# («Дом» → «Коннекторы»): stored in the gateway's database, the tokens and passwords sealed, every change applied at
# once, «не настроено» said plainly. The variables of a connector are read once — at the first start where the
# database has nothing for it (a fresh install, an update from a version without the panel's connectors) — and move
# in; after that they are not read (the log names the ones left), and the panel's values win. A connector cleared in
# the panel stays cleared. A Docker or compose install still sets its connectors here for its first start.

# Lookups the model puts into words.
# Weather: Open-Meteo (no key). A city or "lat,lon"; empty: the city of the station's time zone.
# WEATHER_LOCATION=
# News: RSS or Atom feeds, comma-separated; none: news goes to Yandex. The panel adds from a catalog by topic.
# NEWS_FEEDS=
# Smart home through a provider: Home Assistant's URL and a long-lived access token (Profile → Security);
# empty: the smart home goes to Yandex.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# Whose voice speaks, in gateway mode (in relay mode Yandex does it all). A hard choice, no fallback:
#   yandex — everything in Alice's voice: our answers through a session of our own opened with the station's
#            credentials (only their texts go to Yandex), Yandex's answers as they come;
#   mixed  — our answers in our voice (the engine below), Yandex's in Alice's;
#   own    — everything in our voice: Yandex's answers too, said again from their text (their speech stays here);
#   none   — our answers silent.
TTS_PROVIDER=yandex
# Our own synthesis: an OpenAI-compatible /audio/speech — tts-server/ (Silero, Piper), OpenAI, any other.
# tts-server serves every model of tts-server/models at once: the engine and the voice below choose one, and a
# voice is changed here alone (GET http://127.0.0.1:8091/v1/models lists them). Silero (CC BY-NC 4.0): aidar,
# baya, kseniya, xenia, eugene; Piper: a voice per .onnx, named by its file (ru_RU-denis-medium → denis, CC0).
# TTS_OWN_URL=http://127.0.0.1:8091/v1
# TTS_OWN_MODEL=silero
# TTS_OWN_VOICE=baya
# Cloned voices (omnivoice-server/ on :8092, own venv — one torch per process, hence a sidecar).
# A voice is omnivoice-server/models/<name>/voice_prompt.pt (made from seconds of speech, see its README).
# TTS_OWN_URL=http://127.0.0.1:8092/v1
# TTS_OWN_MODEL=omnivoice
# TTS_OWN_VOICE=<the voice's folder in omnivoice-server/models>
# wav (we encode it for the station) | opus (Ogg/Opus as it is, e.g. OpenAI)
# TTS_OWN_FORMAT=wav
# TTS_OWN_TIMEOUT_MS=8000
# The owner's own cloned voices (panel: «Модели → Голос → ＋ Свой голос»; clone-server/README.md): imprints taken from
# their takes by OmniVoice or CosyVoice 3 (zero-shot), each engine's server on its own port. They need TTS_OWN_URL above.
# Takes and voices (people's voices: never in git), the engines' environments and weights, a bench to copy engines from:
# VOICE_LAB_DIR=data/voice-lab
# VOICE_LAB_RUNTIME_DIR=clone-server/runtime
# VOICE_LAB_BENCH_DIR=../self-voice-tests
# Memory kept for the household while an imprint runs; empty: max(2 GB, 6 % of the memory).
# VOICE_LAB_RESERVE_MB=
# VOICE_LAB_SERVER_URLS=omnivoice=http://127.0.0.1:8093/v1;cosyvoice3=http://127.0.0.1:8094/v1
# One phrase in a cloned voice, counted from its sending (they are said one at a time).
# CLONE_TIMEOUT_MS=30000
# Empty: the session's default voice, which is Alice.
# TTS_VOICE=
TTS_LANG=ru-RU
# For the connection and for each phrase: until audio starts, and between audio frames.
TTS_TIMEOUT_MS=5000
# Synthesis markup in our speech (<speaker is_whisper="true">, <speaker audio="…">, <speaker voice="…">,
# sil<[ms]>) goes to Yandex's synthesis; false takes it out. Not yet checked in our session (experiment 3).
TTS_MARKUP=false
# A whispered question (heard only as quiet speech) gets its answer at a lowered volume, as Yandex does
# (sound_set_level with is_whisper); with TTS_MARKUP also as a whisper.
WHISPER_REPLY=true

# Our own calls (gateway/src/calls): the call page /calls (WebRTC), a station client (station-client/). The hub is
# always on; the bridges below start only when configured.
CALLS_STATION_NAME=Колонка
# The station's microphone during our calls: the station client bridges the station's own audio service
# (127.0.0.1:9850 on the station) to this port; the gateway subscribes for a call's length and takes vqe_gain,
# the channel the station's own calls use. Home network only. Empty: no microphone.
CALLS_STATION_MIC_PORT=9851
# SIP phones and, through an operator's trunk, real numbers: our Asterisk (deploy/asterisk) over ARI. Optional.
# SIP, LiveKit and Telegram below: FIRST START ONLY, then the panel («Дом» → «Коннекторы»).
# ARI_URL=http://127.0.0.1:8088
# ARI_USER=duowave
# ARI_PASSWORD=
# ARI_APP=duowave
# Where Asterisk sends a call's RTP to us (this Mac as Asterisk sees it) and our UDP port for it.
# SIP_RTP_HOST=127.0.0.1
# SIP_RTP_PORT=40000
# SIP_CONTACTS=мама=101;папа=102
# Calls through LiveKit (an optional bridge: calls from outside the home, mobile apps, several people): our server
# (deploy/livekit) or LiveKit Cloud. The family room; tokens: /calls/livekit at home.
# LIVEKIT_URL=ws://127.0.0.1:7880
# Where people's apps reach it from outside, when not at LIVEKIT_URL. Requests from outside the home network count as
# from outside: only the LiveKit page answers them.
# LIVEKIT_PUBLIC_URL=wss://livekit.example.com
# The LiveKit page as people open it from outside. «Позвони маме» from the station then works for
# a Telegram contact who is not in the room: the bot sends a button «Ответить» with a day's access to the room.
# LIVEKIT_PAGE_URL=https://calls.example.com/calls/livekit
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_ROOM=home
# Voice messages through a Telegram bot of the owner's: «передай маме…», and the contacts' messages played on the
# station. Only these contacts are heard; the panel shows who else wrote to the bot, to add them in a tap.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CONTACTS=мама=<chat id>;папа=<chat id>

# Where the gateway runs (docs/plans/station-placement.md): on this computer, on the station, or on the station with
# this computer as its home server. The panel moves it («Дом» → «Шлюз» → «Где работает шлюз»); these are for hands.
# The station's build, when this computer's does not carry one (a local build): duowave-station-aarch64.tar.gz, its
# .sig beside it. Without either the gateway takes the station's build of its own version from the release.
# STATION_PAYLOAD_FILE=
# On the station: its home server — the computer's address and a key made on it with the right «модели этого
# компьютера» (home.models). First values only: then the station's panel («Коннекторы» → «Домашний сервер»).
# HOME_SERVER_URL=http://192.0.2.10:3000
# HOME_SERVER_KEY=
# On the station: the key the computer reaches this gateway with (written by `duowave station install --peer-key`).
# PEER_KEY=
# Who installs this gateway's updates: desktop, docker, home-assistant, pc (the computer that put it on the station),
# yam (the YAM package duowave/gateway), yse (the old .yap). Set by the installers.
# DUOWAVE_MANAGED=
# A computer's build playing the station's gateway — to try the pair on one computer: station.
# DUOWAVE_ROLE=

