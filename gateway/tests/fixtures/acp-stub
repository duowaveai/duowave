#!/usr/bin/env python3
# A stub agent of the Agent Client Protocol for the tests of the works in folders (docs/plans/router-and-works.md,
# stage 3б): JSON-RPC 2.0 over stdio, one message per line. What it does is told by files beside it (the gateway gives
# the agent no environment of the test):
#   protocol — the protocol version it answers to `initialize` (1 when absent);
#   mode     — ok (default): thinks and writes in pieces, a plan, an edit with a diff (and contacts.txt in the copy), asks
#              to run `npm test`, then `git push`, then to read a file outside the copy; a usage with a cost in dollars;
#              nocost: the same, its usage without a cost; slow: works until `session/cancel`; auth: the prompt answers
#              «authentication required»; noload: it cannot load a session.
# It appends to calls.log what it was asked and how its questions were answered.
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))


def read(name, default):
    try:
        with open(os.path.join(HERE, name)) as f:
            return f.read().strip() or default
    except OSError:
        return default


def log(line):
    with open(os.path.join(HERE, "calls.log"), "a") as f:
        f.write(line + "\n")


def send(message):
    message["jsonrpc"] = "2.0"
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def update(session, body):
    send({"method": "session/update", "params": {"sessionId": session, "update": body}})


pending = []  # messages read while waiting for an answer
cancelled = False
next_id = 100
sessions = 0


def receive():
    if pending:
        return pending.pop(0)
    line = sys.stdin.readline()
    if not line:
        sys.exit(0)
    return json.loads(line)


def ask(session, title, kind, raw, locations=None):
    """A question of rights: its answer, the option's kind as the client chose it."""
    global next_id, cancelled
    next_id += 1
    asked = next_id
    call = {"toolCallId": "perm-%d" % asked, "title": title, "kind": kind, "status": "pending", "rawInput": raw}
    if locations:
        call["locations"] = locations
    options = [
        {"optionId": "once", "name": "Allow once", "kind": "allow_once"},
        {"optionId": "always", "name": "Always allow", "kind": "allow_always"},
        {"optionId": "no", "name": "Reject", "kind": "reject_once"},
    ]
    send({"id": asked, "method": "session/request_permission", "params": {"sessionId": session, "toolCall": call, "options": options}})
    while True:
        message = receive()
        if message.get("id") == asked and "result" in message:
            outcome = message["result"]["outcome"]
            chosen = outcome.get("optionId", outcome.get("outcome"))
            log("permission %s -> %s" % (title, chosen))
            return chosen
        if message.get("method") == "session/cancel":
            cancelled = True
            continue
        pending.append(message)


def prompt(message, mode):
    global cancelled
    params = message["params"]
    session = params["sessionId"]
    text = params["prompt"][0]["text"]
    log("prompt %s: %s" % (session, text.replace("\n", " ")))
    if mode == "auth":
        send({"id": message["id"], "error": {"code": -32000, "message": "Authentication required"}})
        return
    if mode == "slow":
        update(session, {"sessionUpdate": "tool_call", "toolCallId": "t-slow", "title": "Run tests", "kind": "execute", "status": "in_progress", "rawInput": {"command": "npm test"}})
        while not cancelled:
            next_message = receive()
            if next_message.get("method") == "session/cancel":
                cancelled = True
        cancelled = False
        send({"id": message["id"], "result": {"stopReason": "cancelled"}})
        return
    update(session, {"sessionUpdate": "agent_thought_chunk", "content": {"type": "text", "text": "A contacts page "}})
    update(session, {"sessionUpdate": "agent_thought_chunk", "content": {"type": "text", "text": "with a form."}})
    update(session, {"sessionUpdate": "plan", "entries": [{"content": "Form", "priority": "high", "status": "in_progress"}]})
    with open("contacts.txt", "a") as f:
        f.write("form\n")
    update(session, {"sessionUpdate": "tool_call", "toolCallId": "t1", "title": "Write contacts.txt", "kind": "edit", "status": "in_progress", "locations": [{"path": os.path.join(os.getcwd(), "contacts.txt")}]})
    update(session, {"sessionUpdate": "tool_call_update", "toolCallId": "t1", "status": "completed", "content": [{"type": "diff", "path": "contacts.txt", "oldText": None, "newText": "form"}]})
    tests = ask(session, "npm test", "execute", {"command": "npm test"})
    status = "completed" if tests == "once" else "failed"
    update(session, {"sessionUpdate": "tool_call", "toolCallId": "t2", "title": "npm test", "kind": "execute", "status": status, "rawInput": {"command": "npm test"}, "content": [{"type": "content", "content": {"type": "text", "text": "Tests: 3 passed" if status == "completed" else "not allowed"}}]})
    ask(session, "git push origin HEAD", "execute", {"command": "git push origin HEAD"})
    ask(session, "Read a secret", "read", {"path": "/etc/hosts"}, [{"path": "/etc/hosts"}])
    usage = {"sessionUpdate": "usage_update", "used": 12000, "size": 200000}
    if mode != "nocost":
        usage["cost"] = {"amount": 0.42, "currency": "USD"}
    update(session, usage)
    update(session, {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Done: "}})
    update(session, {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "the contacts page."}})
    send({"id": message["id"], "result": {"stopReason": "end_turn"}})


def main():
    global sessions
    mode = read("mode", "ok")
    while True:
        message = receive()
        method = message.get("method")
        if method == "initialize":
            log("initialize %s" % json.dumps(message["params"].get("clientCapabilities")))
            version = int(read("protocol", "1"))
            capabilities = {"loadSession": mode != "noload", "promptCapabilities": {}}
            send({"id": message["id"], "result": {"protocolVersion": version, "agentCapabilities": capabilities, "authMethods": [], "agentInfo": {"name": "stub", "version": "0.1.0"}}})
        elif method == "session/new":
            sessions += 1
            session = "acp-%d-%d" % (os.getpid(), sessions)
            log("new %s in %s" % (session, message["params"]["cwd"]))
            options = [{"id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": "default", "options": []}]
            send({"id": message["id"], "result": {"sessionId": session, "configOptions": options}})
        elif method == "session/load":
            session = message["params"]["sessionId"]
            log("load %s" % session)
            update(session, {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "replayed history"}})
            send({"id": message["id"], "result": {}})
        elif method == "session/set_config_option":
            log("model %s" % message["params"]["value"])
            send({"id": message["id"], "result": {"configOptions": []}})
        elif method == "session/prompt":
            prompt(message, mode)
        elif method == "session/cancel":
            pass
        elif "id" in message and method:
            send({"id": message["id"], "error": {"code": -32601, "message": "unknown"}})


if __name__ == "__main__":
    main()
