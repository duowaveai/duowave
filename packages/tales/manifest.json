{
  "schema": 1,
  "kind": "plugin",
  "id": "tales",
  "version": "1.0.0",
  "title": "Сказки",
  "description": "Сказки и аудиокниги из папки дома (content/tales), а без готовой — сказка, которую сочинит модель шлюза. Встроенный плагин: если он выключен, сказки рассказывает встроенный навык.",
  "api": "^1.1",
  "runs": ["pc", "station", "stationServer"],
  "budget": { "memoryMb": 4, "storageMb": 1 },
  "permissions": ["content:tales", "media.source", "voice.intents", "llm.chat"],
  "contributes": {
    "intents": [
      {
        "phrases": ["включи сказку", "включи сказку {query}", "поставь сказку", "поставь сказку {query}", "включи аудиокнигу {query}"],
        "handler": "playTale",
        "capability": "tales"
      },
      {
        "phrases": ["сочини сказку", "сочини сказку {topic}", "придумай сказку", "придумай сказку {topic}"],
        "handler": "composeTale",
        "capability": "tales"
      }
    ],
    "media": [{ "id": "shelf", "kind": "tales", "handler": "shelf" }]
  }
}
