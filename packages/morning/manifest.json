{
  "schema": 1,
  "kind": "plugin",
  "id": "morning",
  "version": "2.0.1",
  "title": "Утреннее шоу",
  "description": "Утреннее шоу из приложений: погода, пара главных новостей и музыка — своя из папки, а без неё радио. «Алиса, доброе утро» или «включи утреннее шоу».",
  "api": "^2",
  "runs": [
    "pc",
    "station",
    "stationServer"
  ],
  "budget": {
    "memoryMb": 4,
    "storageMb": 1
  },
  "permissions": [
    "call:app/weather",
    "call:app/news",
    "call:app/radio",
    "call:system/content"
  ],
  "settings": [
    {
      "key": "news",
      "type": "boolean",
      "title": "Новости в шоу",
      "default": true
    },
    {
      "key": "music",
      "type": "string",
      "title": "Что играть после",
      "options": [
        "своя музыка",
        "радио"
      ],
      "default": "своя музыка"
    }
  ],
  "languages": [
    "ru",
    "en"
  ],
  "locales": {
    "en": {
      "title": "Morning show",
      "description": "A morning show made of apps: the weather, a couple of top news stories and music — your own from the folder, or the radio without it. “Alice, good morning” or “start the morning show”.",
      "settings": {
        "news": {
          "title": "News in the show"
        },
        "music": {
          "title": "What to play afterwards"
        }
      }
    }
  },
  "contributes": {
    "intents": [
      {
        "phrases": [
          "утреннее шоу",
          "включи утреннее шоу",
          "запусти утреннее шоу",
          "давай утреннее шоу",
          "доброе утро",
          "шоу алисы"
        ],
        "handler": "show",
        "capability": "morning_show"
      }
    ]
  }
}
