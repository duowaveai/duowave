{
  "schema": 1,
  "kind": "plugin",
  "id": "currency",
  "version": "1.2.1",
  "title": "Курсы валют",
  "description": "Курсы ЦБ России голосом и виджетом на столе пульта: доллар, евро, юань и другие, на сегодня и как изменились. Открытый источник cbr-xml-daily.ru, без ключа; курс держится час.",
  "api": "^1.1",
  "runs": ["pc", "station", "stationServer"],
  "budget": { "memoryMb": 2, "storageMb": 1 },
  "permissions": ["net:www.cbr-xml-daily.ru", "voice.intents", "llm.tools", "kv"],
  "contributes": {
    "intents": [
      {
        "phrases": [
          "курс доллара",
          "курс доллара {rest}",
          "курс {kind} доллара",
          "какой курс доллара",
          "какой курс доллара {rest}",
          "какой курс {kind} доллара",
          "какой сейчас курс доллара",
          "курс евро",
          "курс евро {rest}",
          "какой курс евро",
          "какой курс евро {rest}",
          "какой сейчас курс евро",
          "курс юаня",
          "курс юаня {rest}",
          "курс {kind} юаня",
          "какой курс юаня",
          "какой курс юаня {rest}",
          "какой сейчас курс юаня",
          "курс фунта",
          "курс фунта {rest}",
          "курс {kind} фунта",
          "какой курс фунта",
          "какой курс фунта {rest}",
          "курс {kind} рубля",
          "курс валют",
          "курс валют {rest}",
          "какой курс валют",
          "сколько стоит доллар",
          "сколько сейчас стоит доллар",
          "сколько стоит евро",
          "сколько сейчас стоит евро",
          "сколько стоит юань",
          "почём доллар",
          "почём евро",
          "почём юань",
          "курсы валют",
          "курсы валют {rest}",
          "какие курсы валют"
        ],
        "handler": "rateSay"
      }
    ],
    "tools": [
      {
        "name": "currency_rates",
        "description": "Официальные курсы ЦБ России на сегодня: рублей за единицу валюты и изменение к прошлому дню. Без кода — доллар, евро и юань.",
        "input": {
          "type": "object",
          "properties": {
            "codes": { "type": "array", "items": { "type": "string" }, "description": "Коды валют: USD, EUR, CNY…" }
          }
        },
        "handler": "currencyRates",
        "annotations": { "readOnlyHint": true }
      }
    ],
    "panel": {
      "slots": ["desk.widgets"],
      "calls": ["panelRates"]
    }
  }
}
